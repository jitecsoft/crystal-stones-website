# Required to send real enquiry notifications.
# Until configured, the API intentionally refuses submissions rather than silently losing leads.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dedicated Crystal Stones Supabase project only. No project is connected by default.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Catalogue assistant for the admin team ("Fill with AI"). Any OpenAI-compatible
# chat API that accepts images works. Gemini example:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
# OpenAI example: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash
